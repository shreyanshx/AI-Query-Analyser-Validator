# AWS / Cognito
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_TOKEN_USE=access

# AI providers (store real values in AWS Secrets Manager, never commit them)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
BEDROCK_REGION=
BEDROCK_MODEL_ID=
AI_PROVIDER_ORDER=gemini,bedrock,openai,anthropic

# Schema cache
SCHEMA_CACHE_TTL_SECONDS=300

# CORS (comma separated)
CORS_ORIGINS=http://localhost:5173

# Feature flags
ENABLE_DATA_SAMPLING=false
EXPLAIN_ENABLED=false

# Secrets Manager (optional; when set, secrets are loaded at startup)
SECRETS_MANAGER_SECRET_ID=
