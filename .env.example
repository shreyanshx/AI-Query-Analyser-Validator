# =============================================================================
# AI Query Analyser & Validator - example configuration
#
# PLACEHOLDER VALUES ONLY. Copy the relevant parts to real config and NEVER
# commit real secrets:
#   - Backend runtime  -> /etc/aiqav/backend.env on EC2 (or backend/.env locally)
#   - Frontend build   -> frontend/.env.production (or frontend/.env locally)
#
# In production, prefer supplying AI provider keys via AWS Secrets Manager
# (SECRETS_MANAGER_SECRET_ID) rather than putting them here or in backend.env.
# =============================================================================

# -----------------------------------------------------------------------------
# BACKEND (FastAPI) - read by app/config.py (pydantic-settings)
# -----------------------------------------------------------------------------

# AWS region used for Cognito, Secrets Manager, and (default) Bedrock.
AWS_REGION=us-east-1

# Amazon Cognito User Pool and PUBLIC app client (no client secret).
# BOTH values are REQUIRED. If either is unset the backend fails closed: every
# protected /api route returns 503 (and logs a startup warning) rather than
# accepting a token on signature alone. This prevents a half-configured deploy
# from accepting any Cognito-signed token.
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Which token to require on protected routes: "access" (default) or "id".
COGNITO_TOKEN_USE=access

# AI provider fallback chain (comma separated, in priority order).
AI_PROVIDER_ORDER=gemini,bedrock,openai,anthropic

# AI provider API keys. Leave BLANK here; inject via Secrets Manager in prod.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Amazon Bedrock (accessed via the EC2 IAM role, no static key needed).
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# AWS Secrets Manager secret id/ARN holding provider keys as JSON. When set,
# the backend merges the secret's keys into the environment at startup.
SECRETS_MANAGER_SECRET_ID=aiqav/backend

# Normalized-schema in-memory cache TTL (seconds).
SCHEMA_CACHE_TTL_SECONDS=300

# Opt-in, limited data sampling for data-aware analysis (off by default).
ENABLE_DATA_SAMPLING=false

# Allow EXPLAIN-based query planning (estimates only unless enabled).
EXPLAIN_ENABLED=false

# Allowed CORS origins (comma separated).
#
# !! PRODUCTION-CRITICAL !! The default below is a LOCAL DEVELOPMENT value only.
# Requests from the SPA are sent with credentials (allow_credentials=True), so
# in production you MUST set this to your real HTTPS SPA origin (for example
# https://app.example.com). If left at the localhost default, the browser will
# reject every cross-origin request from the deployed SPA. The backend logs a
# startup WARNING when this is still the localhost default.
CORS_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------------------
# FRONTEND (React + Vite) - VITE_* vars are PUBLIC and baked into the build.
# These contain no secrets: Cognito ids and region are safe to expose.
# -----------------------------------------------------------------------------

VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_AWS_REGION=us-east-1

# Base URL for the backend API. Leave empty to use the dev proxy (/api -> :8000)
# locally; in production the SPA and API share an origin so this stays empty.
VITE_API_BASE_URL=
